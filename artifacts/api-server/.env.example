# ─── Base de datos ─────────────────────────────────────────────────────────────
# Railway la provee AUTOMÁTICAMENTE al agregar un servicio PostgreSQL.
# No la tenés que configurar manualmente.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ─── MercadoPago ───────────────────────────────────────────────────────────────
# Tu Access Token de PRODUCCIÓN (Panel de MercadoPago → Credenciales)
MP_ACCESS_TOKEN=APP_USR-...

# ─── Panel de administración ───────────────────────────────────────────────────
# La contraseña que usás para entrar a /admin
ADMIN_PASSWORD=tu-contrasena-segura

# ─── URLs de tu sitio ──────────────────────────────────────────────────────────
# FRONTEND_URL → tu URL de Netlify (adonde el cliente vuelve después de pagar)
# API_URL      → tu URL de Railway (adonde MercadoPago envía las notificaciones)
# CORS_ORIGIN  → igual que FRONTEND_URL
#
# Ejemplo:
#   FRONTEND_URL=https://alfis-jeans.netlify.app
#   API_URL=https://alfis-jeans-api.up.railway.app
#   CORS_ORIGIN=https://alfis-jeans.netlify.app
FRONTEND_URL=https://tu-tienda.netlify.app
API_URL=https://tu-api.up.railway.app
CORS_ORIGIN=https://tu-tienda.netlify.app

# ─── Evolution API (publicar productos a grupos/comunidades de WhatsApp) ───────
# La MISMA instancia que ya usa el bot. La key NUNCA va al frontend: sólo acá.
# Sin estas variables, el panel muestra "Evolution no configurada" y no envía nada.
EVOLUTION_URL=https://evolution-api-production-c7acc.up.railway.app
EVOLUTION_KEY=tu-apikey-de-evolution
EVOLUTION_INSTANCE=Alfis Jean
# La tienda: cada producto publicado cierra con el link directo a su página.
WEB_URL=https://alfis.netlify.app

# ─── Cloudinary (imágenes de productos) ────────────────────────────────────────
# Crear cuenta GRATIS en cloudinary.com → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ─── Facturación electrónica ARCA (ex AFIP) vía AfipSDK ────────────────────────
# Token de afipsdk.com. Es OBLIGATORIO incluso para emitir en homologación.
AFIPSDK_TOKEN=tu-access-token-de-afipsdk
# FASE 1 (pruebas): dejar production en false. Los comprobantes que se emiten NO
# tienen validez fiscal; el CUIT de prueba de AfipSDK (20409378472) es el default
# y no necesita certificado.
AFIP_PRODUCTION=false
# FASE 2 (producción): production=true, el CUIT real, y el punto de venta NUEVO
# tipo "Web Services" creado en ARCA (NO el 0011 que usa el otro sistema).
# AFIP_CUIT=30710785585
# AFIP_PTO_VTA=1
